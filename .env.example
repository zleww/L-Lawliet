# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# On Vercel, set the same names under Project Settings > Environment Variables.

# API connection: the lawliet_app role, POOLED host (contains -pooler), TLS required
DATABASE_URL=postgresql://lawliet_app:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# At least 32 random characters. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60

# Comma-separated list of sites allowed to call the API from a browser
ALLOWED_ORIGINS=https://l-lawliet-three.vercel.app,http://127.0.0.1:8000

# ---- Only for scripts/seed.py (local, one time). Not needed on Vercel. ----
# Owner role (neondb_owner); used to load the starting data
SEED_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_USER_USERNAME=student
SEED_USER_PASSWORD=CHANGE_ME
